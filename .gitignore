# ── 依赖与构建产物（都不入库）──
node_modules/
dist/
*.exe
*.blockmap
builder-debug.yml

# ── 运行产物（整体忽略，只放行要当文档展示的几张图与页面）──
out/*
!out/screenshots/
!out/showcase.html
!out/指南.html
!out/RUN-REPORT.md
!out/UI-CHECK.md
!out/UI-RENDER.md
!out/DESKTOP-CHECK.md
out/_shots/
.write-probe
portable.marker

# ── 日志与临时文件 ──
*.log
.verify-cli.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 编辑器 / 系统 ──
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ── 打包缓存 ──
.electron-builder-cache/
electron-builder.env

# ── 内容包（露骨词库，不入库；放这里引擎会自动合并）──
# 说明见 README「内容分级与年龄门禁」：仓库本体只带 heat 1-3，内容包补 4-5 档
content-pack/
content-pack.json

# ── 桌面版打包与衍生数据 ──
dist/
dist/win-unpacked/
dist/open-source-data/
_backup-full-data/
